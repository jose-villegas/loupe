# Renders SCENE with autana's scene_viewer.sh and with LOUPE on the same ARGS
# (|-separated; a trailing --video asks both for a video too) and fails
# unless every file they write is the same bytes.
string(REPLACE "|" ";" args "${ARGS}")
set(video OFF)
if(args MATCHES "(^|;)--video$")
    set(video ON)
    list(POP_BACK args)
endif()
file(MAKE_DIRECTORY "${OUT}")

foreach(side viewer loupe)
    set(outputs -o "${OUT}/${side}.bmp")
    if(video)
        list(APPEND outputs --video "${OUT}/${side}.avi")
    endif()
    if(side STREQUAL "viewer")
        set(command "${SH}" "${AUTANA_DIR}/launcher/tools/render/scene_viewer.sh")
    else()
        set(command "${LOUPE}")
    endif()
    execute_process(COMMAND ${command} "${SCENE}" ${args} ${outputs} RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${side} exited with ${status}")
    endif()
endforeach()

set(files bmp)
if(video)
    list(APPEND files avi)
endif()
foreach(extension IN LISTS files)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}/viewer.${extension}" "${OUT}/loupe.${extension}"
                    RESULT_VARIABLE differ)
    if(differ)
        message(FATAL_ERROR "loupe's .${extension} differs from scene_viewer.sh's: ${OUT}")
    endif()
    message(STATUS "same .${extension}: ${OUT}/loupe.${extension}")
endforeach()
