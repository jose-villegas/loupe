// Bump pull requests for every pin Loupe holds: the submodules (autana, and
// the window's SDL3, Vulkan-Headers, volk and Dear ImGui), the GitHub Actions
// and the CI tools in tools/ci/requirements.txt. Validated by
// .github/workflows/standards.yml.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'helpers:pinGitHubActionDigests'],
  timezone: 'Europe/Berlin',
  schedule: ['before 6am on monday'],

  // Branches and bodies pass autana's check-branch-name.sh and check-pr-ticket.sh.
  branchPrefix: 'feature/',
  branchNameStrict: true,
  prFooter: 'Ticket: i5djy',
  semanticCommits: 'disabled',
  commitMessagePrefix: 'build:',
  rangeStrategy: 'pin',

  'git-submodules': {enabled: true},

  customManagers: [
    {
      // An exact tool version a workflow installs, annotated on the line above it:
      //   # renovate: datasource=npm depName=renovate
      //   RENOVATE_VERSION: 44.151.5
      customType: 'regex',
      managerFilePatterns: ['/^\.github/workflows/[^/]+\.yml$/'],
      matchStrings: ['# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: (?<currentValue>\\S+)'],
    },
  ],

  packageRules: [
    // A major is a migration with its own ticket, opened from the dependency dashboard.
    {matchUpdateTypes: ['major'], dependencyDashboardApproval: true},
    // autana follows its main; the window's libraries follow the release tag
    // .gitmodules names as their branch, each library its own group.
    {matchManagers: ['git-submodules'], matchDepNames: ['third_party/autana'], groupName: 'autana', groupSlug: 'autana'},
    {
      matchManagers: ['git-submodules'],
      matchDepNames: ['third_party/SDL'],
      versioning: 'regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
      groupName: 'SDL3',
      groupSlug: 'sdl3',
    },
    {
      matchManagers: ['git-submodules'],
      matchDepNames: ['third_party/imgui'],
      versioning: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
      groupName: 'Dear ImGui',
      groupSlug: 'imgui',
    },
    {
      // volk is generated from the headers of the same SDK release, so they move together.
      matchManagers: ['git-submodules'],
      matchDepNames: ['third_party/Vulkan-Headers', 'third_party/volk'],
      versioning: 'regex:^vulkan-sdk-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$',
      groupName: 'Vulkan SDK',
      groupSlug: 'vulkan-sdk',
    },
    {matchManagers: ['github-actions'], groupName: 'GitHub Actions', groupSlug: 'github-actions'},
    {matchManagers: ['pip_requirements'], groupName: 'CI tools', groupSlug: 'ci-tools'},
  ],
}
